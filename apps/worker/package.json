{
  "name": "@qis/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Qis Background Worker — Binance WebSocket Price Monitor & Grid Order Trigger",
  "scripts": {
    "dev": "ts-node --esm src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
