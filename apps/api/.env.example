# Database
DATABASE_URL="postgresql://user:password@localhost:5432/qis?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Encryption (for Exchange API secrets)
# 64-char hex string (32 bytes) — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# CORS
CORS_ORIGIN="http://localhost:3000"

# Server
PORT=3001

# AI Service (Python FastAPI)
AI_SERVICE_URL="http://localhost:8000"

# Telegram Bot for user trading notifications
# Get token from @BotFather, chat_id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Ops alerting (monitoring/system alerts to a separate ops channel)
OPS_TELEGRAM_BOT_TOKEN=""
OPS_TELEGRAM_CHAT_ID=""
