// Qis Prisma Schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// User
// ============================================================

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String?
  googleId        String?  @unique
  name            String?
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  exchangeAccounts     ExchangeAccount[]
  refreshTokens        RefreshToken[]
  gridStrategies       GridStrategy[]
  blueprints           StrategyBlueprint[]
  notificationConfig   NotificationConfig?
}

// ============================================================
// Notification Config
// ============================================================

model NotificationConfig {
  id          String   @id @default(cuid())
  userId      String   @unique

  // Telegram
  telegramEnabled   Boolean  @default(false)
  telegramBotToken  String?  // Encrypted
  telegramChatId    String?

  // Discord
  discordEnabled    Boolean  @default(false)
  discordWebhookUrl String?  // Encrypted

  // Email
  emailEnabled      Boolean  @default(false)
  emailAddress      String?
  emailSmtpHost     String?
  emailSmtpPort     Int?
  emailSmtpUser     String?
  emailSmtpPass     String?  // Encrypted

  // Generic Webhook
  webhookEnabled    Boolean  @default(false)
  webhookUrl        String?  // Encrypted
  webhookHeaders    Json?    // Custom headers for webhook

  // Event Filters (which events to notify)
  notifyOrderFilled     Boolean  @default(true)
  notifyOrderError      Boolean  @default(true)
  notifyGridCompleted   Boolean  @default(true)
  notifyGridStopped     Boolean  @default(true)
  notifyCapitalFloorHit Boolean  @default(true)
  notifyDrawdownAlert   Boolean  @default(true)
  notifyTpHit           Boolean  @default(false)
  notifyDailySummary    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// Strategy Blueprint (Immutable Approved AI Plan)
// ============================================================

model StrategyBlueprint {
  id                           String   @id @default(cuid())
  userId                       String
  exchange                     String // 'binance' | 'bybit'
  pair                         String // e.g. 'BTC/USDT'
  tradingCapital               Float
  sectionCount                 Int
  sectionsJson                 Json // GridSection[] (PostgreSQL JSONB)
  capitalProtectionFloor       Float
  floorAction                  String   @default("notify")
  maxCapitalPerMovementPercent Float    @default(40.0)
  maxDrawdownAlertPercent      Float    @default(15.0)
  confidenceScore              Float
  aiReasoning                  String
  createdAt                    DateTime @default(now())
  expiresAt                    DateTime

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gridStrategies GridStrategy[]

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, expiresAt]) // Composite: non-expired blueprints by user
}

// ============================================================
// Grid Strategy (Active Trading Session)
// ============================================================

model GridStrategy {
  id                String    @id @default(cuid())
  userId            String
  blueprintId       String    @unique
  exchangeAccountId String
  exchange          String // 'binance' | 'bybit'
  pair              String // e.g. 'BTC/USDT'
  capital           Float // Total trading capital in USDT
  status            String    @default("active") // 'active' | 'stopping' | 'stopped' | 'completed' | 'error' — 'stopping' is a transient claim state set atomically by stopExecution() while orders are being canceled on the exchange
  startedAt         DateTime  @default(now())
  stoppedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  blueprint       StrategyBlueprint @relation(fields: [blueprintId], references: [id])
  exchangeAccount ExchangeAccount   @relation(fields: [exchangeAccountId], references: [id])
  orders          GridOrder[]

  @@index([userId])
  @@index([status])
  @@index([exchangeAccountId])
  @@index([userId, status]) // Composite: active strategies by user
}

// ============================================================
// Grid Order (Individual Buy/Sell Order)
// ============================================================

model GridOrder {
  id                String    @id @default(cuid())
  gridStrategyId    String
  sectionIndex      Int
  orderIndex        Int // Within section
  globalOrderIndex  Int
  clientOrderId     String    @unique // Idempotency key
  exchangeOrderId   String? // ID returned by exchange
  tpExchangeOrderId String? // TP order ID returned by exchange
  gridPrice         Float // Target buy price level
  tpPrice           Float // Take profit price
  allocatedCapital  Float // Allocated capital in USDT
  estimatedQuantity Float // Estimated token quantity
  status            String    @default("pending")
  // 'pending' | 'placed' | 'filled' | 'tp_placed' | 'tp_filled' | 'canceled' | 'error'
  buyFilledPrice    Float? // Actual fill price
  buyFilledQuantity Float?
  buyFee            Float?
  tpFilledPrice     Float?
  tpFee             Float?
  realizedPnl       Float? // Net PnL after TP hit
  placedAt          DateTime?
  filledAt          DateTime?
  tpFilledAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  gridStrategy GridStrategy @relation(fields: [gridStrategyId], references: [id], onDelete: Cascade)

  @@index([gridStrategyId])
  @@index([status])
  @@index([clientOrderId])
  @@index([gridStrategyId, status]) // Composite: most common query - orders by strategy + status filter
}

// ============================================================
// Exchange Account
// ============================================================

model ExchangeAccount {
  id                  String   @id @default(cuid())
  userId              String
  exchange            String // 'binance' | 'bybit'
  label               String
  // Envelope encryption: ciphertext blob packs iv:authTag:ciphertext (base64).
  // keyVersion enables Master Key rotation without losing which record
  // was encrypted with which KEK version. Per TECH_STACK.md.
  apiKeyEncrypted     String
  apiKeyKeyVersion    Int      @default(1)
  apiSecretEncrypted  String
  apiSecretKeyVersion Int      @default(1)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gridStrategies GridStrategy[]

  @@unique([userId, exchange, label])
  @@index([userId])
  @@index([userId, isActive]) // Composite: active exchange accounts by user
}

// ============================================================
// Refresh Token
// ============================================================

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revoked, expiresAt]) // Composite: valid tokens by user
}

// ============================================================
// Idempotency Key
// Per BUSINESS_RULES_ADDENDUM.md (Idempotency Rules):
// - Every state-changing API request must accept an Idempotency Key
// - Backend stores the key with the resulting state change
// - Returns the original result if the same key is received again
// ============================================================

model IdempotencyKey {
  id        String   @id @default(cuid())
  key       String   @unique
  userId    String
  endpoint  String
  response  Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([key])
  @@index([userId, endpoint, key]) // Composite: idempotency check by user + endpoint
}
